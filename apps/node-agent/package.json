{
  "name": "@vpn-platform/node-agent",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "predev": "pnpm --filter @vpn-platform/contracts build && pnpm --filter @vpn-platform/safe-logger build",
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/main.ts",
    "predev:local-a": "pnpm --filter @vpn-platform/contracts build && pnpm --filter @vpn-platform/safe-logger build",
    "dev:local-a": "node --env-file-if-exists=../../.env --env-file-if-exists=../../var/xray-local/a/agent.env --import tsx --watch src/main.ts",
    "predev:local-b": "pnpm --filter @vpn-platform/contracts build && pnpm --filter @vpn-platform/safe-logger build",
    "dev:local-b": "node --env-file-if-exists=../../.env --env-file-if-exists=../../var/xray-local/b/agent.env --import tsx --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "prestart": "pnpm --filter @vpn-platform/contracts build && pnpm --filter @vpn-platform/safe-logger build",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @vpn-platform/contracts build && pnpm --filter @vpn-platform/safe-logger build",
    "test": "vitest run"
  },
  "dependencies": {
    "@vpn-platform/contracts": "workspace:*",
    "@vpn-platform/safe-logger": "workspace:*",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "vitest": "^3.2.4"
  }
}
