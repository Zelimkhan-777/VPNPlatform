{
  "openapi": "3.0.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "HealthController_live",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Проверить, что процесс API работает",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Выполняет PostgreSQL SELECT 1 через Prisma и Redis PING с ограниченным timeout.",
        "operationId": "HealthController_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": "PostgreSQL и Redis доступны",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "dependencies"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ready"
                      ]
                    },
                    "dependencies": {
                      "type": "object",
                      "required": [
                        "postgres",
                        "redis"
                      ],
                      "properties": {
                        "postgres": {
                          "type": "string",
                          "enum": [
                            "up",
                            "down"
                          ]
                        },
                        "redis": {
                          "type": "string",
                          "enum": [
                            "up",
                            "down"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Одна из зависимостей недоступна",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "dependencies"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "unavailable"
                      ]
                    },
                    "dependencies": {
                      "type": "object",
                      "required": [
                        "postgres",
                        "redis"
                      ],
                      "properties": {
                        "postgres": {
                          "type": "string",
                          "enum": [
                            "up",
                            "down"
                          ]
                        },
                        "redis": {
                          "type": "string",
                          "enum": [
                            "up",
                            "down"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Проверить доступность зависимостей API",
        "tags": [
          "health"
        ]
      }
    },
    "/auth/telegram": {
      "post": {
        "description": "Секрет сессии передаётся только в HttpOnly cookie. Telegram initData и секрет сессии не возвращаются в JSON.",
        "operationId": "AuthController_signIn",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "initData"
                ],
                "properties": {
                  "initData": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "user",
                    "expiresAt"
                  ],
                  "properties": {
                    "user": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "role"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "role": {
                          "type": "string",
                          "enum": [
                            "CUSTOMER",
                            "ADMIN"
                          ]
                        }
                      }
                    },
                    "expiresAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Некорректное тело запроса"
          },
          "401": {
            "description": "Telegram login не прошёл проверку"
          },
          "404": {
            "description": "Вход через Telegram ещё не настроен"
          }
        },
        "summary": "Создать серверную сессию по подписанным Telegram Web App данным",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "AuthController_current",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "user",
                    "expiresAt"
                  ],
                  "properties": {
                    "user": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "role"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "role": {
                          "type": "string",
                          "enum": [
                            "CUSTOMER",
                            "ADMIN"
                          ]
                        }
                      }
                    },
                    "expiresAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Сессия отсутствует, истекла или отозвана"
          }
        },
        "summary": "Получить текущую серверную сессию",
        "tags": [
          "auth"
        ]
      }
    },
    "/cabinet/overview": {
      "get": {
        "description": "Возвращает только данные владельца активной сессии; не содержит subscription URL, хешей или VPN-ключей.",
        "operationId": "CabinetController_overview",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "subscription",
                    "devices"
                  ],
                  "properties": {
                    "subscription": {
                      "nullable": true,
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "status",
                        "planName",
                        "deviceLimit",
                        "startsAt",
                        "expiresAt"
                      ],
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "PENDING",
                            "ACTIVE",
                            "EXPIRED",
                            "CANCELLED"
                          ]
                        },
                        "planName": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "deviceLimit": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "startsAt": {
                          "type": "string",
                          "format": "date-time",
                          "nullable": true
                        },
                        "expiresAt": {
                          "type": "string",
                          "format": "date-time",
                          "nullable": true
                        }
                      }
                    },
                    "devices": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "id",
                          "displayName",
                          "platform",
                          "status",
                          "createdAt"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "displayName": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128,
                            "nullable": true
                          },
                          "platform": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 32,
                            "nullable": true
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "ACTIVE",
                              "REVOKED"
                            ]
                          },
                          "createdAt": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Сессия отсутствует, истекла или отозвана"
          }
        },
        "summary": "Получить безопасную сводку кабинета текущего пользователя",
        "tags": [
          "cabinet"
        ]
      }
    },
    "/cabinet/devices": {
      "post": {
        "description": "Проверяет активную подписку, лимит устройств и Origin кабинета. Полный subscription URL возвращается только в этом ответе и не сохраняется в API.",
        "operationId": "CabinetController_issueDevice",
        "parameters": [
          {
            "name": "idempotency-key",
            "in": "header",
            "description": "UUID generated by the cabinet for safe request retry",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "origin",
            "in": "header",
            "description": "Trusted cabinet origin",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "displayName",
                    "platform",
                    "status",
                    "createdAt",
                    "subscriptionUrl"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "displayName": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "nullable": true
                    },
                    "platform": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 32,
                      "nullable": true
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "ACTIVE"
                      ]
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "subscriptionUrl": {
                      "type": "string",
                      "format": "uri"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Некорректное тело запроса"
          },
          "401": {
            "description": "Сессия отсутствует, истекла или отозвана"
          },
          "403": {
            "description": "Недоверенный Origin кабинета"
          },
          "409": {
            "description": "Нет активной подписки или исчерпан лимит"
          },
          "503": {
            "description": "Выдача устройства не настроена"
          }
        },
        "summary": "Выпустить устройство текущего пользователя",
        "tags": [
          "cabinet"
        ]
      }
    },
    "/cabinet/devices/{deviceId}/revoke": {
      "post": {
        "description": "Идемпотентно отзывает только принадлежащее текущему пользователю устройство и ставит обновление desired state для связанных нод.",
        "operationId": "CabinetController_revokeDevice",
        "parameters": [
          {
            "name": "origin",
            "in": "header",
            "description": "Trusted cabinet origin",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "deviceId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Устройство отозвано или уже отозвано"
          },
          "400": {
            "description": "Некорректный идентификатор устройства"
          },
          "401": {
            "description": "Сессия отсутствует, истекла или отозвана"
          },
          "403": {
            "description": "Недоверенный Origin кабинета"
          },
          "404": {
            "description": "Устройство пользователя не найдено"
          }
        },
        "summary": "Отозвать устройство текущего пользователя",
        "tags": [
          "cabinet"
        ]
      }
    },
    "/sub/{token}": {
      "get": {
        "description": "Bearer token устройства проверяется сервером. Пока пул VPN-нод не подключён, успешный ответ содержит пустой список конфигураций.",
        "operationId": "SubscriptionFeedController_feed",
        "parameters": [
          {
            "name": "token",
            "required": true,
            "in": "path",
            "description": "Opaque device subscription token",
            "schema": {
              "type": "string",
              "minLength": 43,
              "maxLength": 43
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Текстовый subscription feed",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "maxLength": 16384
                }
              }
            }
          },
          "401": {
            "description": "Неверный, отозванный или истёкший token"
          },
          "429": {
            "description": "Too many requests"
          }
        },
        "summary": "Получить subscription feed устройства",
        "tags": [
          "subscription-feed"
        ]
      }
    },
    "/node-agent/v1/configuration": {
      "get": {
        "description": "Возвращает lifecycle grants аутентифицированной healthy-ноды и только ей нужные client credentials. Не содержит URL, device ID или credential-хешей.",
        "operationId": "NodeAgentController_configurationSnapshot",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "desiredConfigVersion",
                    "appliedConfigVersion",
                    "pendingAcknowledgement",
                    "grants"
                  ],
                  "properties": {
                    "desiredConfigVersion": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "appliedConfigVersion": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "pendingAcknowledgement": {
                      "type": "object",
                      "nullable": true,
                      "additionalProperties": false,
                      "required": [
                        "nodeSyncJobId",
                        "targetVersion"
                      ],
                      "properties": {
                        "nodeSyncJobId": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "targetVersion": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    },
                    "grants": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "id",
                          "status",
                          "expiresAt",
                          "desiredVersion",
                          "appliedVersion",
                          "revokedAt",
                          "dataPlaneCredential"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "PENDING",
                              "ACTIVE",
                              "REVOKED"
                            ]
                          },
                          "expiresAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "desiredVersion": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "appliedVersion": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "revokedAt": {
                            "type": "string",
                            "format": "date-time",
                            "nullable": true
                          },
                          "dataPlaneCredential": {
                            "type": "string",
                            "format": "uuid",
                            "nullable": true
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Недействительная credential ноды"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Получить снимок желаемого состояния ноды",
        "tags": [
          "node-agent"
        ]
      }
    },
    "/node-agent/v1/heartbeats": {
      "post": {
        "description": "Принимается только от credential healthy-ноды. Не меняет статус ноды и не принимает время от агента.",
        "operationId": "NodeAgentController_heartbeat",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Heartbeat принят"
          },
          "401": {
            "description": "Недействительная credential ноды"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Зафиксировать серверное время последнего контакта ноды",
        "tags": [
          "node-agent"
        ]
      }
    },
    "/node-agent/v1/acknowledgements": {
      "post": {
        "description": "Принимает только credential конкретной healthy-ноды. Конфигурации, учётные данные пользователей и секреты в ответе не возвращаются.",
        "operationId": "NodeAgentController_acknowledge",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "nodeSyncJobId",
                  "targetVersion"
                ],
                "properties": {
                  "nodeSyncJobId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "targetVersion": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Подтверждение принято идемпотентно"
          },
          "400": {
            "description": "Неверное тело подтверждения"
          },
          "401": {
            "description": "Недействительная credential ноды"
          },
          "409": {
            "description": "Задача не принадлежит ноде или ещё не может быть подтверждена"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Подтвердить применённую версию конфигурации ноды",
        "tags": [
          "node-agent"
        ]
      }
    },
    "/prototype/subscription/{token}": {
      "get": {
        "description": "Только для закрытого локального прототипа; endpoint выключен по умолчанию. Содержимое fixture задаётся только через некоммитимую локальную переменную окружения.",
        "operationId": "SubscriptionPrototypeController_feed",
        "parameters": [
          {
            "name": "token",
            "required": true,
            "in": "path",
            "description": "Opaque local-only prototype token",
            "schema": {
              "minLength": 32,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Текстовый fixture subscription-ответа",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "# VPNPlatform local subscription prototype\\n"
                }
              }
            }
          },
          "401": {
            "description": "Неверный или отсутствующий токен"
          },
          "404": {
            "description": "Локальный прототип выключен"
          },
          "429": {
            "description": "Too many requests"
          }
        },
        "summary": "Получить локальный fixture subscription-ответа",
        "tags": [
          "subscription-prototype"
        ]
      }
    }
  },
  "info": {
    "title": "VPNPlatform API",
    "description": "",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "opaque",
        "type": "http"
      }
    },
    "schemas": {}
  }
}
