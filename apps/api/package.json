{
  "name": "@vpn-platform/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "predev": "pnpm --filter @vpn-platform/contracts build && pnpm --filter @vpn-platform/orchestration-store build && pnpm --filter @vpn-platform/safe-logger build",
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/main.ts",
    "build": "nest build",
    "prestart": "pnpm --filter @vpn-platform/contracts build && pnpm --filter @vpn-platform/orchestration-store build && pnpm --filter @vpn-platform/safe-logger build",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "admin:check-legacy-admin": "node --env-file-if-exists=../../.env --import tsx src/cli/admin-check-legacy-admin.ts",
    "admin:demote-legacy-admin": "node --env-file-if-exists=../../.env --import tsx src/cli/admin-demote-legacy-admin.ts",
    "bot:credential": "node --env-file-if-exists=../../.env --import tsx src/cli/bot-credential.ts",
    "prisma:migrate:deploy": "node --env-file-if-exists=../../.env --import tsx src/cli/migrate-deploy.ts",
    "pretest": "pnpm --filter @vpn-platform/contracts build && pnpm --filter @vpn-platform/orchestration-store build && pnpm --filter @vpn-platform/safe-logger build && pnpm --filter @vpn-platform/node-agent build",
    "test": "vitest run --exclude test/infrastructure/**/*.e2e.test.ts --exclude scripts/integration-cleanup-probe.test.ts",
    "pretest:integration": "pnpm --filter @vpn-platform/contracts build && pnpm --filter @vpn-platform/orchestration-store build && pnpm --filter @vpn-platform/safe-logger build && pnpm --filter @vpn-platform/node-agent build",
    "test:integration": "node --env-file-if-exists=../../.env --import tsx scripts/run-integration-tests.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-fastify": "^11.1.6",
    "@nestjs/swagger": "^11.2.1",
    "@prisma/client": "6.19.3",
    "@vpn-platform/contracts": "workspace:*",
    "@vpn-platform/orchestration-store": "workspace:*",
    "@vpn-platform/safe-logger": "workspace:*",
    "ioredis": "5.11.1",
    "nestjs-pino": "^4.4.1",
    "pino": "^9.9.4",
    "prisma": "6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/supertest": "^6.0.3",
    "@vpn-platform/node-agent": "workspace:*",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4"
  }
}
