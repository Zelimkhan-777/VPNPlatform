{
  "name": "@vpn-platform/worker",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "predev": "pnpm --filter @vpn-platform/contracts build && pnpm --filter @vpn-platform/safe-logger build",
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "prestart": "pnpm --filter @vpn-platform/contracts build && pnpm --filter @vpn-platform/safe-logger build",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @vpn-platform/contracts build && pnpm --filter @vpn-platform/safe-logger build",
    "test": "vitest run --exclude src/outbox-publisher.integration.test.ts --exclude src/node-sync-processor.integration.test.ts",
    "pretest:integration": "pnpm --filter @vpn-platform/contracts build && pnpm --filter @vpn-platform/safe-logger build",
    "test:integration": "node --env-file-if-exists=../../.env --import tsx scripts/run-integration-tests.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@vpn-platform/contracts": "workspace:*",
    "@vpn-platform/safe-logger": "workspace:*",
    "bullmq": "^5.61.0",
    "pino": "^9.9.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "vitest": "^3.2.4"
  }
}
