generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
}

enum AdminRole {
  OWNER
  OPERATOR
  SUPPORT
  FINANCE
  AUDITOR
}

enum AdminTotpCredentialStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum PendingLoginStatus {
  AWAITING_BOT_CONFIRM
  BOT_CONFIRMED
  CONSUMED
}

enum OrderStatus {
  PENDING
  SUCCEEDED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum DeviceStatus {
  ACTIVE
  REVOKED
}

enum NodeStatus {
  PROVISIONING
  HEALTHY
  DRAINING
  DISABLED
  QUARANTINED
  DELETED
}

enum EndpointAddressKind {
  HOSTNAME
  IPV4
  IPV6
}

enum EndpointStatus {
  ACTIVE
  DISABLED
}

enum ConnectionProfileStatus {
  DRAFT
  ACTIVE
  DISABLED
}

enum ConnectionProtocolKind {
  VLESS
  WIREGUARD
}

enum ConnectionTransportKind {
  TCP
  WEBSOCKET
  GRPC
}

enum ConnectionSecurityKind {
  NONE
  TLS
  REALITY
}

enum ClientCompatibilityKind {
  HAPP
}

enum NodeAccessGrantStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum NodeSyncJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

model User {
  id               String            @id @default(uuid()) @db.Uuid
  telegramUserId   String            @unique @db.VarChar(32)
  role             UserRole          @default(CUSTOMER)
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(6)
  subscriptions    Subscription[]
  devices          Device[]
  sessions         UserSession[]
  authChallenges   AuthChallenge[]
  pendingLogins    PendingLogin[]
  orders           Order[]
  promoRedemptions PromoRedemption[]
  adminMembership  AdminMembership?
  auditEvents      AuditEvent[]      @relation("AuditActor")

  @@unique([id, telegramUserId])
}

model UserSession {
  id                 String         @id @default(uuid()) @db.Uuid
  userId             String         @db.Uuid
  tokenHash          String         @unique @db.Char(64)
  telegramReplayHash String?        @unique @db.Char(64)
  expiresAt          DateTime       @db.Timestamptz(6)
  revokedAt          DateTime?      @db.Timestamptz(6)
  createdAt          DateTime       @default(now()) @db.Timestamptz(6)
  user               User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  authChallenge      AuthChallenge?

  @@unique([id, userId])
  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model AuthChallenge {
  id                 String         @id @default(uuid()) @db.Uuid
  launchId           String         @unique @db.VarChar(64)
  tokenHash          String         @unique @db.Char(64)
  telegramReplayHash String?        @unique @db.Char(64)
  sessionId          String?        @db.Uuid
  expiresAt          DateTime       @db.Timestamptz(6)
  consumedAt         DateTime?      @db.Timestamptz(6)
  createdAt          DateTime       @default(now()) @db.Timestamptz(6)
  userId             String?        @db.Uuid
  session            UserSession?   @relation(fields: [sessionId, userId], references: [id, userId], onDelete: Restrict)
  user               User?          @relation(fields: [userId], references: [id], onDelete: Restrict)
  pendingLogins      PendingLogin[]

  @@unique([id, userId])
  @@unique([sessionId, userId])
  @@index([expiresAt])
  @@index([expiresAt, consumedAt])
  @@index([userId])
}

model Plan {
  id            String         @id @default(uuid()) @db.Uuid
  code          String         @unique @db.VarChar(64)
  name          String         @db.VarChar(128)
  priceMinor    Int
  currency      String         @db.Char(3)
  durationDays  Int
  deviceLimit   Int
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(6)
  subscriptions Subscription[]
  orders        Order[]
  promoCodes    PromoCode[]
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @db.Uuid
  planId         String      @db.Uuid
  idempotencyKey String      @unique @db.VarChar(128)
  amountMinor    Int
  currency       String      @db.Char(3)
  status         OrderStatus @default(PENDING)
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(6)
  user           User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan           Plan        @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments       Payment[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @unique @db.Uuid
  providerPaymentId String?       @unique @db.VarChar(128)
  amountMinor       Int
  currency          String        @db.Char(3)
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(6)
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, status])
  @@index([status, createdAt])
}

model PromoCode {
  id             String            @id @default(uuid()) @db.Uuid
  planId         String            @db.Uuid
  secretHash     String            @unique @db.Char(64)
  campaignName   String            @db.VarChar(128)
  durationDays   Int
  maxUniqueUsers Int
  startsAt       DateTime?         @db.Timestamptz(6)
  endsAt         DateTime?         @db.Timestamptz(6)
  isActive       Boolean           @default(true)
  comment        String?           @db.VarChar(512)
  archivedAt     DateTime?         @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(6)
  plan           Plan              @relation(fields: [planId], references: [id], onDelete: Restrict)
  redemptions    PromoRedemption[]

  @@index([planId, isActive])
  @@index([isActive, startsAt, endsAt])
}

model PromoRedemption {
  id          String    @id @default(uuid()) @db.Uuid
  promoCodeId String    @db.Uuid
  userId      String    @db.Uuid
  redeemedAt  DateTime  @default(now()) @db.Timestamptz(6)
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([promoCodeId, userId])
  @@index([userId, redeemedAt])
}

model PendingLogin {
  id                   String             @id @default(uuid()) @db.Uuid
  challengeId          String             @db.Uuid
  userId               String             @db.Uuid
  telegramUserId       String             @db.VarChar(32)
  pendingTokenHash     String             @unique @db.Char(64)
  confirmationCodeHash String             @db.Char(64)
  status               PendingLoginStatus @default(AWAITING_BOT_CONFIRM)
  expiresAt            DateTime           @db.Timestamptz(6)
  confirmedAt          DateTime?          @db.Timestamptz(6)
  consumedAt           DateTime?          @db.Timestamptz(6)
  createdAt            DateTime           @default(now()) @db.Timestamptz(6)
  challenge            AuthChallenge      @relation(fields: [challengeId, userId], references: [id, userId], onDelete: Restrict)
  user                 User               @relation(fields: [userId, telegramUserId], references: [id, telegramUserId], onDelete: Restrict)

  @@index([challengeId, status])
  @@index([telegramUserId, confirmationCodeHash, status])
  @@index([expiresAt, status])
}

model AdminMembership {
  id              String                @id @default(uuid()) @db.Uuid
  userId          String                @unique @db.Uuid
  role            AdminRole
  createdAt       DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(6)
  user            User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessions        AdminSession[]
  totpCredentials AdminTotpCredential[]

  @@index([role])
}

model AdminSession {
  id               String          @id @default(uuid()) @db.Uuid
  membershipId     String          @db.Uuid
  tokenHash        String          @unique @db.Char(64)
  stepUpVerifiedAt DateTime?       @db.Timestamptz(6)
  expiresAt        DateTime        @db.Timestamptz(6)
  revokedAt        DateTime?       @db.Timestamptz(6)
  createdAt        DateTime        @default(now()) @db.Timestamptz(6)
  membership       AdminMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)

  @@index([membershipId, revokedAt])
  @@index([expiresAt])
}

model AdminTotpCredential {
  id                   String                    @id @default(uuid()) @db.Uuid
  membershipId         String                    @db.Uuid
  keyCiphertext        String                    @db.Text
  nonce                String                    @db.VarChar(128)
  keyVersion           Int
  status               AdminTotpCredentialStatus @default(PENDING)
  lastVerifiedTimestep BigInt?
  enrolledAt           DateTime?                 @db.Timestamptz(6)
  revokedAt            DateTime?                 @db.Timestamptz(6)
  createdAt            DateTime                  @default(now()) @db.Timestamptz(6)
  membership           AdminMembership           @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  recoveryCodes        AdminRecoveryCode[]

  @@index([membershipId, status])
}

model AdminRecoveryCode {
  id           String              @id @default(uuid()) @db.Uuid
  credentialId String              @db.Uuid
  codeHash     String              @unique @db.Char(64)
  consumedAt   DateTime?           @db.Timestamptz(6)
  createdAt    DateTime            @default(now()) @db.Timestamptz(6)
  credential   AdminTotpCredential @relation(fields: [credentialId], references: [id], onDelete: Restrict)

  @@index([credentialId, consumedAt])
}

model AdminBootstrapState {
  id        Int       @id
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
}

model BotServicePrincipal {
  id             String                  @id @default(uuid()) @db.Uuid
  name           String                  @unique @db.VarChar(128)
  createdAt      DateTime                @default(now()) @db.Timestamptz(6)
  credentials    BotServiceCredential[]
  idempotencyLog BotRequestIdempotency[]
}

model BotServiceCredential {
  id            String              @id @default(uuid()) @db.Uuid
  principalId   String              @db.Uuid
  keyCiphertext String              @db.Text
  nonce         String              @db.VarChar(128)
  keyVersion    Int
  revokedAt     DateTime?           @db.Timestamptz(6)
  createdAt     DateTime            @default(now()) @db.Timestamptz(6)
  principal     BotServicePrincipal @relation(fields: [principalId], references: [id], onDelete: Restrict)

  @@index([principalId, revokedAt])
}

model BotRequestIdempotency {
  id             String              @id @default(uuid()) @db.Uuid
  principalId    String              @db.Uuid
  method         String              @db.VarChar(16)
  path           String              @db.VarChar(512)
  telegramUserId String              @db.VarChar(32)
  idempotencyKey String              @db.VarChar(128)
  requestHash    String              @db.Char(64)
  responseStatus Int?
  responseBody   Json?
  completedAt    DateTime?           @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(6)
  principal      BotServicePrincipal @relation(fields: [principalId], references: [id], onDelete: Restrict)

  @@unique([principalId, method, path, telegramUserId, idempotencyKey], map: "BotRequestIdempotency_scope_key")
  @@index([principalId, createdAt])
}

model Subscription {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @db.Uuid
  planId      String             @db.Uuid
  status      SubscriptionStatus @default(PENDING)
  startsAt    DateTime?          @db.Timestamptz(6)
  expiresAt   DateTime?          @db.Timestamptz(6)
  cancelledAt DateTime?          @db.Timestamptz(6)
  createdAt   DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(6)
  user        User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan        Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([expiresAt])
}

model Device {
  id                         String            @id @default(uuid()) @db.Uuid
  userId                     String            @db.Uuid
  displayName                String?           @db.VarChar(128)
  platform                   String?           @db.VarChar(32)
  status                     DeviceStatus      @default(ACTIVE)
  subscriptionTokenHash      String            @unique @db.VarChar(128)
  issuanceIdempotencyKeyHash String?           @unique @db.Char(64)
  subscriptionTokenVersion   Int               @default(1)
  revokedAt                  DateTime?         @db.Timestamptz(6)
  createdAt                  DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime          @updatedAt @db.Timestamptz(6)
  user                       User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  nodeAccessGrants           NodeAccessGrant[]

  @@index([userId, status])
}

model Node {
  id                     String                      @id @default(uuid()) @db.Uuid
  name                   String                      @unique @db.VarChar(128)
  provider               String                      @db.VarChar(128)
  locationLabel          String                      @db.VarChar(128)
  status                 NodeStatus                  @default(PROVISIONING)
  desiredConfigVersion   Int                         @default(0)
  appliedConfigVersion   Int                         @default(0)
  lastHeartbeatAt        DateTime?                   @db.Timestamptz(6)
  lastHealthCheckAt      DateTime?                   @db.Timestamptz(6)
  createdAt              DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                    @updatedAt @db.Timestamptz(6)
  nodeAccessGrants       NodeAccessGrant[]
  syncJobs               NodeSyncJob[]
  configAcknowledgements NodeConfigAcknowledgement[]
  configDeliveries       NodeConfigDelivery[]
  agentCredentials       NodeAgentCredential[]
  endpoints              Endpoint[]
  connectionProfiles     ConnectionProfile[]

  @@index([status])
}

model Endpoint {
  id               String                      @id @default(uuid()) @db.Uuid
  nodeId           String                      @db.Uuid
  host             String                      @db.VarChar(253)
  addressKind      EndpointAddressKind
  port             Int
  priority         Int                         @default(0)
  status           EndpointStatus              @default(ACTIVE)
  createdAt        DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                    @updatedAt @db.Timestamptz(6)
  node             Node                        @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  connectionRoutes EndpointConnectionProfile[]

  @@unique([id, nodeId])
  @@index([nodeId, status, priority])
}

model ConnectionProfile {
  id                      String                      @id @default(uuid()) @db.Uuid
  nodeId                  String                      @db.Uuid
  profileKey              String                      @default(uuid()) @db.Uuid
  version                 Int
  status                  ConnectionProfileStatus     @default(DRAFT)
  protocolKind            ConnectionProtocolKind
  transportKind           ConnectionTransportKind
  securityKind            ConnectionSecurityKind
  clientCompatibility     ClientCompatibilityKind
  priority                Int                         @default(0)
  createdAt               DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                    @updatedAt @db.Timestamptz(6)
  node                    Node                        @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  endpointRoutes          EndpointConnectionProfile[]
  vlessTcpTlsPublicConfig VlessTcpTlsPublicConfig?

  @@unique([id, nodeId])
  @@unique([nodeId, profileKey, version])
  @@index([nodeId, status, priority])
}

model VlessTcpTlsPublicConfig {
  id                  String            @id @default(uuid()) @db.Uuid
  connectionProfileId String            @unique @db.Uuid
  tlsServerName       String            @db.VarChar(253)
  displayName         String            @db.VarChar(128)
  createdAt           DateTime          @default(now()) @db.Timestamptz(6)
  connectionProfile   ConnectionProfile @relation(fields: [connectionProfileId], references: [id], onDelete: Restrict)
}

model EndpointConnectionProfile {
  endpointId            String            @db.Uuid
  connectionProfileId   String            @db.Uuid
  nodeId                String            @db.Uuid
  activationVersion     Int?
  lastActivationVersion Int               @default(0)
  endpoint              Endpoint          @relation(fields: [endpointId, nodeId], references: [id, nodeId], onDelete: Restrict)
  connectionProfile     ConnectionProfile @relation(fields: [connectionProfileId, nodeId], references: [id, nodeId], onDelete: Restrict)
  syncJobs              NodeSyncJob[]

  @@id([endpointId, connectionProfileId])
  @@unique([endpointId, connectionProfileId, nodeId], map: "EndpointConnectionProfile_route_node_key")
  @@index([nodeId])
  @@index([nodeId, activationVersion])
}

model NodeAccessGrant {
  id                                   String                @id @default(uuid()) @db.Uuid
  nodeId                               String                @db.Uuid
  deviceId                             String                @db.Uuid
  status                               NodeAccessGrantStatus @default(PENDING)
  dataPlaneCredentialHash              String                @unique @db.VarChar(128)
  dataPlaneCredentialDerivationVersion Int?                  @db.SmallInt
  expiresAt                            DateTime              @db.Timestamptz(6)
  desiredVersion                       Int                   @default(0)
  appliedVersion                       Int                   @default(0)
  revokedAt                            DateTime?             @db.Timestamptz(6)
  createdAt                            DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt                            DateTime              @updatedAt @db.Timestamptz(6)
  node                                 Node                  @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  device                               Device                @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  syncJobs                             NodeSyncJob[]         @relation("NodeSyncGrant")

  @@unique([nodeId, deviceId])
  @@unique([id, nodeId])
  @@index([nodeId, status])
  @@index([deviceId, status])
  @@index([expiresAt])
}

model NodeSyncJob {
  id                       String                     @id @default(uuid()) @db.Uuid
  nodeId                   String                     @db.Uuid
  nodeAccessGrantId        String?                    @db.Uuid
  routeEndpointId          String?                    @db.Uuid
  routeConnectionProfileId String?                    @db.Uuid
  targetVersion            Int
  idempotencyKey           String                     @unique @db.VarChar(128)
  status                   NodeSyncJobStatus          @default(PENDING)
  attempts                 Int                        @default(0)
  nextAttemptAt            DateTime?                  @db.Timestamptz(6)
  leaseOwner               String?                    @db.VarChar(128)
  leaseToken               String?                    @db.Uuid
  leaseExpiresAt           DateTime?                  @db.Timestamptz(6)
  lastErrorCode            String?                    @db.VarChar(128)
  completedAt              DateTime?                  @db.Timestamptz(6)
  createdAt                DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                   @updatedAt @db.Timestamptz(6)
  node                     Node                       @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  nodeAccessGrant          NodeAccessGrant?           @relation("NodeSyncGrant", fields: [nodeAccessGrantId, nodeId], references: [id, nodeId], onDelete: Restrict)
  connectionRoute          EndpointConnectionProfile? @relation(fields: [routeEndpointId, routeConnectionProfileId, nodeId], references: [endpointId, connectionProfileId, nodeId], onDelete: Restrict)
  configAcknowledgement    NodeConfigAcknowledgement?
  configDeliveries         NodeConfigDelivery[]

  @@unique([id, nodeId, targetVersion], map: "NodeSyncJob_id_nodeId_targetVersion_key")
  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
  @@index([nodeId, targetVersion])
}

model NodeConfigAcknowledgement {
  id             String              @id @default(uuid()) @db.Uuid
  nodeId         String              @db.Uuid
  nodeSyncJobId  String              @unique @db.Uuid
  targetVersion  Int
  snapshotHash   String?             @db.Char(64)
  acknowledgedAt DateTime            @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)
  node           Node                @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  nodeSyncJob    NodeSyncJob         @relation(fields: [nodeSyncJobId], references: [id], onDelete: Restrict)
  delivery       NodeConfigDelivery? @relation("AcknowledgedDelivery", fields: [nodeSyncJobId, snapshotHash], references: [nodeSyncJobId, snapshotHash], onDelete: Restrict)

  @@unique([nodeId, targetVersion])
  @@unique([nodeSyncJobId, snapshotHash], map: "NodeConfigAcknowledgement_job_hash_key")
  @@index([nodeId, acknowledgedAt])
}

model NodeConfigDelivery {
  id                    String                     @id @default(uuid()) @db.Uuid
  nodeId                String                     @db.Uuid
  nodeSyncJobId         String                     @db.Uuid
  targetVersion         Int
  snapshotHash          String                     @db.Char(64)
  deliveredAt           DateTime                   @default(now()) @db.Timestamptz(6)
  createdAt             DateTime                   @default(now()) @db.Timestamptz(6)
  node                  Node                       @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  nodeSyncJob           NodeSyncJob                @relation(fields: [nodeSyncJobId, nodeId, targetVersion], references: [id, nodeId, targetVersion], onDelete: Restrict)
  configAcknowledgement NodeConfigAcknowledgement? @relation("AcknowledgedDelivery")

  @@unique([nodeSyncJobId, snapshotHash], map: "NodeConfigDelivery_job_hash_key")
  @@index([nodeId, targetVersion])
}

model NodeAgentCredential {
  id         String    @id @default(uuid()) @db.Uuid
  nodeId     String    @db.Uuid
  secretHash String    @unique @db.Char(64)
  revokedAt  DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  node       Node      @relation(fields: [nodeId], references: [id], onDelete: Restrict)

  @@index([nodeId, revokedAt])
}

model OutboxEvent {
  id             String            @id @default(uuid()) @db.Uuid
  topic          String            @db.VarChar(128)
  aggregateType  String            @db.VarChar(64)
  aggregateId    String            @db.Uuid
  payload        Json
  idempotencyKey String            @unique @db.VarChar(128)
  status         OutboxEventStatus @default(PENDING)
  attempts       Int               @default(0)
  nextAttemptAt  DateTime?         @db.Timestamptz(6)
  leaseOwner     String?           @db.VarChar(128)
  leaseToken     String?           @db.Uuid
  leaseExpiresAt DateTime?         @db.Timestamptz(6)
  publishedAt    DateTime?         @db.Timestamptz(6)
  lastErrorCode  String?           @db.VarChar(128)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(6)

  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
  @@index([aggregateType, aggregateId])
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String   @db.VarChar(128)
  entityType  String   @db.VarChar(64)
  entityId    String   @db.Uuid
  metadata    Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
}
