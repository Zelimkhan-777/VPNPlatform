model AvailabilityState {
  id                           String                   @id @default(uuid()) @db.Uuid
  scopeKind                    HealthScopeKind
  scopeKey                     String                   @db.VarChar(128)
  status                       AvailabilityHealthStatus @default(UNKNOWN)
  excludedFromCandidates       Boolean                  @default(true)
  consecutiveFailureCycles     Int                      @default(0)
  consecutiveRecoverySuccesses Int                      @default(0)
  recoveryWindowStartedAt      DateTime?                @db.Timestamptz(6)
  consecutiveUncertainCycles   Int                      @default(0)
  cooldownUntil                DateTime?                @db.Timestamptz(6)
  version                      BigInt                   @default(0)
  createdAt                    DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt                    DateTime                 @updatedAt @db.Timestamptz(6)
  decisions                    AvailabilityDecision[]

  @@unique([scopeKind, scopeKey])
  @@index([status, excludedFromCandidates])
}

model AvailabilityDecision {
  id                           String                       @id @default(uuid()) @db.Uuid
  idempotencyKey               String                       @unique @db.Char(64)
  availabilityStateId          String                       @db.Uuid
  stateVersion                 BigInt
  healthPolicyVersionId        String?                      @db.Uuid
  signalIds                    Json
  inputProbeResultIds          Json
  decision                     AvailabilityHealthStatus
  reason                       AvailabilityDecisionReason
  excludedFromCandidates       Boolean
  consecutiveFailureCycles     Int
  consecutiveRecoverySuccesses Int
  recoveryWindowStartedAt      DateTime?                    @db.Timestamptz(6)
  consecutiveUncertainCycles   Int
  cooldownUntil                DateTime?                    @db.Timestamptz(6)
  allowNewAssignments          Boolean
  triggerReplacement           Boolean
  triggerIncident              Boolean
  cycleStartedAt               DateTime?                    @db.Timestamptz(6)
  routeVersion                 Int?
