model NodeOperation {
  id                     String                     @id @default(uuid()) @db.Uuid
  incidentId             String                     @db.Uuid
  availabilityDecisionId String                     @db.Uuid
  healthPolicyVersionId  String                     @db.Uuid
  idempotencyKey         String                     @unique @db.Char(64)
  type                   NodeOperationType
