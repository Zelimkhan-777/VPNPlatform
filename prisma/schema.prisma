  healthPolicyVersion          HealthPolicyVersion?         @relation(fields: [healthPolicyVersionId], references: [id], onDelete: Restrict)
  signalLinks                  AvailabilityDecisionSignal[]
  incident                     Incident?
  nodeOperations               NodeOperation[]

  @@unique([availabilityStateId, stateVersion])
  @@index([availabilityStateId, decidedAt])
  @@index([healthPolicyVersionId, decidedAt])
}

