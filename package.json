{
  "name": "vpn-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm -r --if-present build",
    "lint": "prettier --check . && eslint . --max-warnings=0",
    "typecheck": "pnpm -r --if-present typecheck",
    "pretest": "pnpm --filter @vpn-platform/contracts build && pnpm --filter @vpn-platform/orchestration-store build && pnpm --filter @vpn-platform/safe-logger build && pnpm --filter @vpn-platform/node-agent build",
    "test": "pnpm -r --if-present test && pnpm test:infra",
    "test:infra": "node --test infra/compose-guardrails.test.mjs infra/container-image-manifest.test.mjs infra/platform/backup/backup.test.mjs infra/vpn-node/systemd-installer.test.mjs infra/vpn-node/xray-serving-lifecycle.test.mjs",
    "infra:compose:validate": "node --test infra/compose-guardrails.test.mjs",
    "platform:compose:validate": "docker compose --env-file infra/platform/production.env.example -f infra/docker-compose.production.yml --profile bot config --quiet",
    "platform:backup:validate": "node --test infra/platform/backup/backup.test.mjs",
    "platform:backup:smoke": "node infra/platform/backup/smoke.mjs",
    "infra:scripts:lint": "node infra/lint-shell-scripts.mjs && pwsh -NoLogo -NoProfile -File infra/lint-powershell-scripts.ps1",
    "infra:images:build": "node infra/build-container-images.mjs",
    "infra:images:smoke": "node infra/smoke-container-images.mjs",
    "infra:images:publish": "node infra/publish-container-images.mjs",
    "test:integration": "pnpm --filter @vpn-platform/api test:integration && pnpm --filter @vpn-platform/worker test:integration",
    "format": "prettier --write .",
    "db:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d",
    "db:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "xray:local:up": "node infra/xray-local/prepare.mjs && docker compose -f infra/docker-compose.xray-local.yml up -d",
    "xray:local:down": "docker compose -f infra/docker-compose.xray-local.yml down",
    "xray:local:restart": "docker compose -f infra/docker-compose.xray-local.yml restart xray-a xray-b",
    "xray:local:harness": "pnpm --filter @vpn-platform/api exec -- node --env-file-if-exists=../../.env --import tsx scripts/local-two-node-harness.ts",
    "vpn-fi:bootstrap": "pnpm --filter @vpn-platform/api exec -- node --env-file-if-exists=../../.env --import tsx scripts/vpn-fi-bootstrap.ts",
    "vpn-eu:bootstrap": "pnpm --filter @vpn-platform/api exec -- node --env-file-if-exists=../../.env --import tsx scripts/vpn-eu-bootstrap.ts",
    "vpn-node:prepare": "node infra/xray-production/prepare.mjs",
    "vpn-node:up": "node infra/xray-production/prepare.mjs && docker compose -f infra/docker-compose.vpn-node.yml up -d control-plane-proxy",
    "vpn-node:down": "docker compose -f infra/docker-compose.vpn-node.yml down",
    "vpn-node:break-glass-start-xray": "docker compose -f infra/docker-compose.vpn-node.yml up -d xray",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@prisma/client": "6.19.3",
    "@types/node": "^24.7.2",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "prisma": "^6.19.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1"
  }
}
