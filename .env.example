# Local infrastructure only. Replace these values in non-local environments.
POSTGRES_DB=vpn_platform
POSTGRES_USER=vpn_platform
POSTGRES_PASSWORD=vpn_platform_local
POSTGRES_PORT=5432
POSTGRES_HOST=127.0.0.1

REDIS_PORT=6379
REDIS_HOST=127.0.0.1
REDIS_URL=redis://127.0.0.1:6379
# All API-owned Redis keys are prefixed centrally. Use a distinct value per
# deployed API environment; integration tests generate their own namespace.
API_REDIS_KEY_NAMESPACE=vpn-platform:api

DATABASE_URL=postgresql://vpn_platform:vpn_platform_local@127.0.0.1:5432/vpn_platform?schema=public

API_HOST=127.0.0.1
API_PORT=3001
HEALTH_CHECK_TIMEOUT_MS=750
LOG_LEVEL=info
# Keep empty for direct API access. In production list only the IP addresses of
# reverse proxies that are allowed to supply the real client address.
# TRUSTED_PROXY_IPS=192.0.2.10,2001:db8::10

# Telegram Web App login stays unavailable until both values are supplied.
# Store real values in a secret manager; never commit them.
# TELEGRAM_WEB_APP_BOT_TOKEN=
# AUTH_SESSION_PEPPER=
AUTH_SESSION_TTL_SECONDS=604800
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300
AUTH_PRELAUNCH_RATE_LIMIT_MAX=10
AUTH_PRELAUNCH_RATE_LIMIT_WINDOW_MS=60000
AUTH_CHALLENGE_CLEANUP_BATCH_SIZE=100

# Store only in a secret manager outside local development. Required in production
# before node-agent credentials can be used; never commit a real value.
# NODE_AGENT_CREDENTIAL_PEPPER=

# Separate HMAC pepper for per-grant data-plane client credentials. Required in
# production; generate and keep it in secret storage, never in Git.
# DATA_PLANE_CREDENTIAL_PEPPER=

# Required in production before device-specific subscription tokens can be
# verified. Store the real value only in a secret manager; never commit it.
# SUBSCRIPTION_TOKEN_PEPPER=
# SUBSCRIPTION_FEED_BASE_URL=https://sub.example.com
# CABINET_ORIGIN=https://app.example.com
SUBSCRIPTION_FEED_RATE_LIMIT_MAX=60
SUBSCRIPTION_FEED_RATE_LIMIT_WINDOW_MS=60000
SUBSCRIPTION_FEED_RENDERING_ENABLED=false
SUBSCRIPTION_FEED_MAX_ROUTES=25

# The local subscription fixture is disabled by default. Do not commit its token.
LOCAL_SUBSCRIPTION_PROTOTYPE_ENABLED=false
# LOCAL_SUBSCRIPTION_PROTOTYPE_TOKEN=
# LOCAL_SUBSCRIPTION_PROTOTYPE_CONTENT=
LOCAL_SUBSCRIPTION_PROTOTYPE_RATE_LIMIT_MAX=5
LOCAL_SUBSCRIPTION_PROTOTYPE_RATE_LIMIT_WINDOW_MS=60000
LOCAL_SUBSCRIPTION_PROTOTYPE_RATE_LIMIT_MAX_CLIENTS=10000
ORCHESTRATION_LEASE_DURATION_MS=30000
ORCHESTRATION_MAX_ATTEMPTS=5

# The worker publishes validated transactional outbox events to BullMQ. It stays
# disabled by default and requires DATABASE_URL plus REDIS_URL when enabled.
WORKER_ENABLED=false
WORKER_QUEUE_NAME=node-sync
# WORKER_ID=worker-local-1
WORKER_POLL_INTERVAL_MS=1000
WORKER_RETRY_DELAY_MS=5000
NODE_SYNC_RETRY_DELAY_MS=30000
NODE_SYNC_CONCURRENCY=4

# The node agent is a separate data-plane process. Default adapter is a local
# state-file simulation. `local-xray` applies the same snapshot to a localhost
# Xray process. Both modes are rejected when NODE_ENV=production.
NODE_AGENT_ENABLED=false
# NODE_AGENT_API_BASE_URL=http://127.0.0.1:3001
# NODE_AGENT_CREDENTIAL=
NODE_AGENT_MODE=simulation
NODE_AGENT_STATE_FILE=./var/node-agent/state.json
NODE_AGENT_XRAY_TEMPLATE_PATH=./infra/xray-local/config.template.json
NODE_AGENT_XRAY_RUNTIME_CONFIG=./var/xray-local/config.json
NODE_AGENT_XRAY_INBOUND_TAG=vless-tcp-tls
NODE_AGENT_POLL_INTERVAL_MS=30000
NODE_AGENT_REQUEST_TIMEOUT_MS=5000
